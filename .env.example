# --- Model: any OpenAI-compatible chat-completions endpoint ---
# OpenAI, Groq, OpenRouter, Together, vLLM, Ollama (http://localhost:11434/v1) all work.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: "low" cuts thinking time on reasoning models (Gemini 3, o-series).
LLM_REASONING_EFFORT=

# --- Web search: pick one. Priority: Tavily -> Brave -> DuckDuckGo (no key) ---
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Optional ---
PORT=3000
TZ_NAME=Asia/Kolkata
DATA_DIR=.data
